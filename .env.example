# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Token secreto que o N8N deve enviar no header Authorization: Bearer <token>
# em toda chamada aos webhooks (/api/webhooks/*, /api/campanhas/:id/status)
N8N_WEBHOOK_SECRET=troque-por-um-token-longo-e-aleatorio

# URL base da instância N8N (usada nos links de Configurações)
N8N_BASE_URL=https://seu-n8n.exemplo.com

# UAIZAP
UAIZAP_API_KEY=
UAIZAP_BASE_URL=

# Site público (landing) — Farmácia Preço Bom
# Número em formato internacional, só dígitos: 55 + DDD + número
NEXT_PUBLIC_WHATSAPP_NUMERO=5571999999999
NEXT_PUBLIC_IFOOD_URL=https://www.ifood.com.br/delivery/salvador-ba/farmacia-preco-bom
NEXT_PUBLIC_SITE_URL=https://precobom.com.br

# Token secreto que o CRM deve enviar em Authorization: Bearer <token> pra
# POST /api/revalidate quando uma promoção mudar (atualiza a home antes dos 5min de cache)
REVALIDATE_SECRET=troque-por-um-token-longo-e-aleatorio
