# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Token secreto que o N8N deve enviar no header Authorization: Bearer <token>
# em toda chamada aos webhooks (/api/webhooks/*, /api/campanhas/:id/status)
N8N_WEBHOOK_SECRET=troque-por-um-token-longo-e-aleatorio

# URL base da instância N8N (usada nos links de Configurações)
N8N_BASE_URL=https://seu-n8n.exemplo.com

# UAIZAP
UAIZAP_API_KEY=
UAIZAP_BASE_URL=

# Claude (widget interno "Vitória AI" — referência de contraindicação/genérico)
ANTHROPIC_API_KEY=

# Token secreto que o CRM envia (header Authorization: Bearer <token>) pra
# avisar o site público que a Vitrine mudou e ele deve revalidar a página. A
# URL de destino fica em Configurações → Integrações (site_revalidate_url);
# esse token tem que ser o MESMO configurado no projeto do site
# (REVALIDATE_SECRET, em src/app/api/revalidate/route.ts).
SITE_REVALIDATE_SECRET=troque-por-um-token-longo-e-aleatorio
