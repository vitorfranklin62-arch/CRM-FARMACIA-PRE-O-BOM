    {
      "parameters": {
        "jsCode": "\n// Três coisas acontecem aqui:\n//   1. decide se o envio deu certo;\n//   2. sorteia quanto tempo esperar antes do próximo (e a parada longa\n//      quando fecha um lote);\n//   3. segura o disjuntor — falha em série faz o disparo parar.\nconst cfg = $('Loop Campanhas').item.json.cfg;\nconst enviado = $('Loop Clientes').item.json;\nconst resposta = $input.first().json || {};\n\nconst deuErro = !!resposta.error;\nconst mensagemErro = deuErro\n  ? String(resposta.error.message || resposta.error.description || resposta.error).slice(0, 500)\n  : null;\n\n// Estado de execução. Zera quando muda a execução, então uma rodada nunca\n// herda o contador da anterior.\nconst estado = $getWorkflowStaticData('global');\nif (estado.execucao !== $execution.id) {\n  estado.execucao = $execution.id;\n  estado.falhasSeguidas = 0;\n  estado.enviados = 0;\n}\n\nif (deuErro) {\n  estado.falhasSeguidas++;\n} else {\n  estado.falhasSeguidas = 0;\n  estado.enviados++;\n}\n\nconst abortar = estado.falhasSeguidas >= cfg.falhasSeguidasParaAbortar;\n\nfunction sortearInteiro(min, max) {\n  return Math.floor(Math.random() * (max - min + 1)) + min;\n}\n\n// Fecha lote? Para mais tempo. Senão, só o intervalo curto sorteado.\nconst fechouLote = estado.enviados > 0 && estado.enviados % cfg.loteTamanho === 0;\nconst esperar = fechouLote\n  ? sortearInteiro(cfg.pausaLongaMinMin, cfg.pausaLongaMaxMin) * 60\n  : sortearInteiro(cfg.pausaMinSeg, cfg.pausaMaxSeg);\n\nreturn [{\n  json: {\n    campanha_id: enviado.campanha_id,\n    cliente_id: enviado.cliente_id,\n    telefone: enviado.numero,\n    status: deuErro ? 'falhou' : 'enviado',\n    erro: mensagemErro,\n    abortar,\n    fechou_lote: fechouLote,\n    esperar_segundos: abortar ? 1 : esperar,\n    falhas_seguidas: estado.falhasSeguidas,\n    enviados_nesta_execucao: estado.enviados,\n  },\n}];\n"
      },
