    {
      "parameters": {
        "jsCode": "\n// Mandar pra número que não tem WhatsApp é um dos sinais que mais pesam\n// contra o remetente. Conferimos a lista inteira numa chamada só e\n// separamos quem fica de quem sai.\nconst fila = $('Montar fila').all().map(i => i.json);\n\nif (fila.length === 1 && fila[0].nada_a_enviar) {\n  return [{ json: fila[0] }];\n}\n\nconst cfg = fila[0].cfg;\n\n// A resposta de /chat/check muda de formato conforme a versão; juntamos\n// tudo que parecer uma lista de resultados e indexamos pelos dígitos.\nconst respostas = $input.all().map(i => i.json);\nconst registros = [];\nfor (const r of respostas) {\n  if (!r || r.error) continue;\n  const possiveis = Array.isArray(r) ? r\n    : Array.isArray(r.numbers) ? r.numbers\n    : Array.isArray(r.result) ? r.result\n    : Array.isArray(r.data) ? r.data\n    : Array.isArray(r.chats) ? r.chats\n    : [r];\n  registros.push(...possiveis.filter(Boolean));\n}\n\nconst mapa = new Map();\nfor (const reg of registros) {\n  const chave = String(\n    reg.query || reg.number || reg.jid || reg.phone || reg.wa_id || ''\n  ).replace(/\\D/g, '');\n  if (!chave) continue;\n  // Só tratamos como \"não tem\" quando a API diz isso com todas as letras.\n  // Na dúvida, manda: barrar por causa de uma resposta que não entendemos\n  // pararia a campanha inteira à toa.\n  const naoTem = reg.exists === false || reg.exists === 'false' || reg.isInWhatsapp === false;\n  mapa.set(chave, !naoTem);\n}\n\nconst houveResposta = mapa.size > 0;\n\nconst saida = fila.map(f => {\n  // Sem resposta utilizável da checagem, seguimos com o envio: barrar todo\n  // mundo por causa de uma API fora do ar seria pior que o problema.\n  const temWhatsapp = houveResposta ? (mapa.get(f.numero) ?? true) : true;\n  return { json: { ...f, tem_whatsapp: temWhatsapp, descartar: !temWhatsapp } };\n});\n\nconst aptos = saida.filter(s => s.json.tem_whatsapp);\n\nif (aptos.length === 0) {\n  return [{ json: {\n    nada_a_enviar: true,\n    campanha_id: fila[0].campanha_id,\n    cfg,\n    descartados: saida.map(s => s.json),\n    diagnostico: { motivo: 'nenhum número da fila tem WhatsApp' },\n  }}];\n}\n\nreturn saida;\n"
      },
