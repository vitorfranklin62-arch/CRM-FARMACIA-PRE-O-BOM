    {
      "parameters": {
        "jsCode": "\n// ===========================================================================\n// PAINEL DE CONTROLE — é aqui que se mexe pra afrouxar ou apertar o disparo.\n// ===========================================================================\nconst cfg = {\n  // --- Ritmo entre uma mensagem e a próxima (segundos, sorteado no intervalo)\n  // Intervalo fixo é assinatura de robô; o sorteio quebra o padrão.\n  pausaMinSeg: 25,\n  pausaMaxSeg: 75,\n\n  // --- A cada N mensagens, uma parada longa (minutos, também sorteada).\n  // Imita gente: manda um punhado, larga o celular, volta depois.\n  loteTamanho: 20,\n  pausaLongaMinMin: 4,\n  pausaLongaMaxMin: 9,\n\n  // --- Tetos de volume\n  limiteDia: 250,        // total no dia, somando TODAS as campanhas\n  limitePorExecucao: 60, // máximo que uma rodada tenta enviar\n\n  // --- Janela de horário (hora local de São Paulo) e dias da semana.\n  // 0 = domingo. Mensagem de madrugada é o que mais rende denúncia.\n  horaInicio: 8,\n  horaFim: 20,\n  diasPermitidos: [1, 2, 3, 4, 5, 6],\n\n  // --- Disjuntor: N falhas seguidas param tudo e a campanha volta pra\n  // rascunho, esperando alguém olhar. Falha em série normalmente quer dizer\n  // que a instância caiu ou que o número já está limitado.\n  falhasSeguidasParaAbortar: 5,\n\n  // --- Rodapé de descadastro. Dar uma saída fácil é o que evita o cliente\n  // usar a única outra saída que ele tem: denunciar como spam.\n  rodapeOptout: '\\n\\nPara não receber mais, responda SAIR.',\n\n  // --- Saudações. A primeira lista entra no lugar de {{saudacao}} e precisa\n  // combinar com o nome logo depois (\"Oi, Maria!\"). A segunda só é usada\n  // quando o cliente não tem nome no cadastro, aí a frase inteira é trocada.\n  saudacoes: ['Oi', 'Olá'],\n  saudacoesSemNome: ['Oi, tudo bem?', 'Olá, tudo bem?', 'Oi!', 'Olá!'],\n};\n\n// Webhook e agendamento podem trazer a mesma campanha na mesma rodada.\nconst vistas = new Set();\nconst saida = [];\n\nfor (const item of $input.all()) {\n  const c = item.json;\n  if (!c || !c.id || vistas.has(c.id)) continue;\n  vistas.add(c.id);\n  saida.push({ json: { ...c, cfg } });\n}\n\nreturn saida;\n"
      },
